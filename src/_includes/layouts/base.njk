<!DOCTYPE html>
<html lang="{{ site.lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }} — {{ site.tagline }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}">
    <meta name="author" content="{{ site.author }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <meta property="og:locale" content="{{ site.locale }}">
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:title" content="{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }}{% endif %}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta name="twitter:card" content="summary">
    <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/assets/img/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,500;0,600;1,400&family=Source+Serif+4:opsz,ital,wght@8..60,0,400;8..60,0,600;8..60,0,700;8..60,1,400&display=swap">
    <link rel="stylesheet" href="/assets/css/main.css">
    {% if jsonLd %}
    <script type="application/ld+json">{{ jsonLd | safe }}</script>
    {% endif %}
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>
    {% include "partials/header.njk" %}
    <main id="conteudo">
      {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
    {% if extraJs %}
    <script src="{{ extraJs }}" defer></script>
    {% endif %}
  </body>
</html>
